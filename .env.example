# Copy to `.env`. Compose reads it; nothing else does.

# The absolute path, on the host, of the annotation tree — the directory that
# holds `quorum/`, `raw_vids/` and `sync_id_ui/`. It is mounted at the *same*
# path inside the container, so a database made by `./run.sh` keeps working and
# one made in the container keeps working outside it. Everything else is
# derived from this, so it is the one value that has to be right.
TREE=/home/arian/Documents/jlab/annotation

# Where state lives. Defaults to $TREE/quorum/data — the same directory
# `./run.sh` uses — so the two ways of running this share one installation.
# Point it elsewhere (a bigger disk) and the container follows.
#DATA=/home/arian/Documents/jlab/annotation/quorum/data

# The docker network the SAM nuclio container is on. It is CVAT's, because the
# function is a CVAT serverless function — `deploy_gpu.sh` passes
# `--platform-config '{"attributes": {"network": "cvat_cvat"}}'`. Confirm with:
#   docker inspect -f '{{json .NetworkSettings.Networks}}' \
#     nuclio-nuclio-pth-comfyorg-sam3-1-v2
SAM_NETWORK=cvat_cvat

# Where the function answers, by container name and its fixed internal port.
# Not a published host port: nuclio picks a new random one on every deploy.
SAM_URL=http://nuclio-nuclio-pth-comfyorg-sam3-1-v2:8080/

# Install the docker CLI in the image so the auto-annotator can start the SAM
# 3.1 GPU image. Set to 0 if you only want the interactor and the tracker; the
# SAM panel then says so rather than failing oddly.
WITH_DOCKER=1

# Run the container as you rather than as root: `data/` is shared with
# `./run.sh` on the host, and root-owned files in it break the host-side server.
#   id -u ; id -g ; getent group docker | cut -d: -f3
PUID=1000
PGID=1000
DOCKER_GID=999

# Where the server is published. 127.0.0.1 keeps it on this machine; use
# 0.0.0.0 for the lab, and then set QUORUM_AUTH=token and hand out tokens with
#   docker compose exec quorum python -m quorum user alice --role annotator
BIND=127.0.0.1
PORT=8600
QUORUM_AUTH=open
