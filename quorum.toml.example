# Copy to quorum.toml to override any default. Paths are relative to this file.

host = "127.0.0.1"
port = 8600

# "open"  — one operator, no login (the posture the desktop tools have today)
# "token" — bearer tokens from the users table; make one with:
#             .venv/bin/python -m quorum user alice --role reviewer
auth_mode = "open"
dev_user  = "local"

jobs_workers = 2

# Nothing outside these roots is ever readable over HTTP, whatever a provider
# puts in a media path. The default is this file's parent's parent — fine in
# the annotation tree, too broad on a laptop, where it is your home directory.
# Name the one directory the videos are in instead. On Windows use forward
# slashes: TOML reads `\` as an escape.
media_roots = [".."]
# media_roots = ["C:/Users/you/videos"]

# plugin_paths = ["plugins", "/opt/quorum-plugins"]
# plugins_enabled = ["grid_capture", "mask_layer", "identity", "proposals", "cvat_xml"]

# Per-plugin settings arrive as `ctx.settings("key")`.
# [plugins.grid_capture]
# root = ".."
# prepared_dir = "../sync_id_ui/data"

# [plugins.sam]
# Where the SAM 3.1 nuclio function answers. By container name on a shared
# docker network rather than by published port: nuclio republishes on a new
# random host port on every deploy. $SAM_URL overrides this.
# url = "http://nuclio-nuclio-pth-comfyorg-sam3-1-v2:8080/"
#
# How long the readiness probe waits before calling the service dead, in
# seconds. Three suits a service on this host. Raise it when the service is
# across a network — a laptop reaching a SAM on a relayed tailnet needs several
# round trips to say hello, and the probe timing out is indistinguishable, in
# the panel, from the service being down. The real calls are unaffected; they
# already allow 120 s and 900 s. $SAM_PROBE_TIMEOUT overrides this.
# probe_timeout = 15
#
# The image the auto-annotator starts. Quorum never pulls it.
# image = "cvat.pth.comfyorg.sam3.1:latest-gpu"
# gpus = "all"
#
# Run your own checkout of sam3_auto_annotator instead of the vendored copy.
# annotator_dir = "/home/you/Codes/newlabelstudio/sam3_auto_annotator"
#
# There is no path_map any more. It belonged to the design where Quorum drove
# `docker run` itself; the auto-annotator is now an HTTP call to the service,
# which is handed `--video <path> --output <path>` and opens both on its own
# filesystem. So the rule is simpler and stricter: **the auto-annotator only
# works when Quorum and the service can see the same files at the same paths.**
# The interactor and the tracker are unaffected — they post frames as bytes, so
# those two work fine against a service on another machine.
#
# Who the SAM container runs as. Empty (the default) means the image's own
# user, which is root — how upstream's run.sh has always run it. The XML it
# writes is then root-owned; the directory is Quorum's, so those files can
# still be replaced and deleted, but set this if you would rather they were
# not.  id -u ; id -g
# run_as = "1000:1000"
